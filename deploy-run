#!/bin/sh
# deploy-run <pr> [--hold] -- start a change. A light wrapper over `gh label`.
#
# This is the whole of a person's part. It adds release:started and stops.
# Everything after is the system acting or observing, and the name shape of
# each label says which (.claude/skills/_shared/vocabulary.md).
#
# It deliberately does NOT deploy. An earlier version of this file drove the
# entire pipeline -- guards, staging, cutover, convergence -- which made it a
# second implementation of the control flow, and made shipping something a
# person did by hand rather than something passing the gates did. That script
# is change/activate.sh now, and activation calls it.
#
# So there is no promote button here, and there is no deploy button either.
# The only verbs a person has are: ask (release:started), hold (hold:staging),
# and release the hold.
set -eu
cd "$(dirname "$0")"
R="${GH_REPO:-${GITHUB_REPOSITORY:-aygp-dr/standard-change}}"

PR=''; HOLD=0; RELEASE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --hold)    HOLD=1 ;;
    --release) RELEASE=1 ;;
    --status)  PR="${2:?}"; shift
               gh pr view "$PR" --repo "$R" --json number,title,labels,reviewDecision,mergeStateStatus \
                 -q '"#\(.number) \(.title)\n  review=\(.reviewDecision) merge=\(.mergeStateStatus)\n  labels: \([.labels[].name]|join(", "))"'
               ./change/schedule.sh current "$PR" staging >/dev/null 2>&1 \
                 && echo "  window: $(./change/schedule.sh current "$PR" staging) (open, covering now)" \
                 || echo "  window: none covering now — ./change/schedule.sh block $PR \"\$(./change/groups.sh $PR)\" 30"
               exit 0 ;;
    -*)        echo "usage: deploy-run <pr> [--hold|--release] | --status <pr>" >&2; exit 2 ;;
    *)         PR="$1" ;;
  esac
  shift
done
[ -n "$PR" ] || { echo "usage: deploy-run <pr> [--hold|--release] | --status <pr>" >&2; exit 2; }

# hold:staging is the one human stop: it keeps a change in staging so a person
# can verify there, instead of letting green gates promote it. Only a person
# adds it and only a person removes it -- a hold a machine can lift is not a
# hold. See README.org, "The one way to stop it".
if [ "$HOLD" = 1 ]; then
  gh pr edit "$PR" --repo "$R" --add-label hold:staging
  echo "#$PR held at staging. Production will not be touched."
  echo "  release with: ./deploy-run $PR --release  (the guards re-run on release)"
  exit 0
fi
if [ "$RELEASE" = 1 ]; then
  gh pr edit "$PR" --repo "$R" --remove-label hold:staging
  echo "#$PR released. The guards re-run — a hold is time, and time is what guard 4b watches."
  exit 0
fi

# Refuse to raise a request for a change that cannot become one. Not a guard --
# the guards run in the pipeline, on fresher facts than these. This only avoids
# minting a request that the very next step would reject.
# shellcheck disable=SC2178,SC2128  # GROUPS is a string; the earlier `set --`
# in this file makes shellcheck think otherwise
GROUPS=$(./change/groups.sh "$PR")
[ -n "$GROUPS" ] || { echo "refused: #$PR carries no app:* label — nothing to deploy" >&2; exit 2; }

gh pr edit "$PR" --repo "$R" --add-label release:started
echo "#$PR requested  groups=$GROUPS"
if WIN=$(./change/schedule.sh current "$PR" staging 2>/dev/null); then
  echo "  window $WIN is open and covers now — the scheduler may activate at any moment"
else
  echo "  no window covering now. Reserving is not deploying, and it is not yours to do:"
  echo "  the scheduler books it. Reserving by hand asserts an action nobody took."
fi
