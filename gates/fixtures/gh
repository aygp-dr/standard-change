#!/bin/sh
# A `gh` that answers from recorded JSON. Put first on PATH by
# gates/observation-test.sh so the guard under test runs unmodified and offline.
#
# It deliberately does NOT stub out jq: the fixture is handed to the real `-q` /
# `--jq` filter the guard wrote. Those filters are where this kind of bug
# actually lives, so a stub that answered them itself would be testing the
# stub.
set -eu
FIX="${FIXTURE:?gh stub: FIXTURE is not set}"

# gh spells the same thing -q for `pr view` and --jq for `api`.
filter='.'
prev=''
for a in "$@"; do
  case "$prev" in -q|--jq) filter="$a" ;; esac
  prev="$a"
done

case "${1:-}" in
  pr)
    case "${2:-}" in
      view)    jq -r "$filter" "$FIX/pr.json" ;;
      # Same rule as reviews.json below: a fixture with no open-prs.json cannot
      # ANSWER, which is a different fact from "there are no open PRs". Exit 1
      # so the guard takes its could-not-determine branch and blocks.
      list)    [ -f "$FIX/open-prs.json" ] || exit 1
               jq -r "$filter" "$FIX/open-prs.json" ;;
      edit|comment|merge)
               printf '%s\n' "$*" >> "${GUARD4_WRITES:-/dev/null}" ;;
      *)       echo "gh stub: unhandled 'pr $2'" >&2; exit 1 ;;
    esac ;;
  api)
    case "${2:-}" in
      *check-runs*) jq -r "$filter" "$FIX/check-runs.json" ;;
      # A fixture without reviews.json is a fixture that cannot ANSWER, which is
      # a different fact from "there are no reviews" -- exit 1 so the guard takes
      # its unreachable branch, exactly as it would against a real forge that
      # refused. Fixtures that want the reachable case ship the file.
      */reviews*)   [ -f "$FIX/reviews.json" ] || exit 1
                    jq -r "$filter" "$FIX/reviews.json" ;;
      *comments*)   jq -r "$filter" "$FIX/comments.json" ;;
      *deployments*) [ -f "$FIX/deployments.json" ] || exit 1
                    jq -r "$filter" "$FIX/deployments.json" ;;
      *)            echo "gh stub: unhandled api path '$2'" >&2; exit 1 ;;
    esac ;;
  *) echo "gh stub: unhandled '$1'" >&2; exit 1 ;;
esac
